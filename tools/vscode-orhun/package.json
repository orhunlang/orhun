{
  "name": "orhun-language",
  "displayName": "Orhun Language",
  "description": "Orhun 1.0 language support: Turkish-first syntax, teaching-friendly snippets, English keyword aliases, and ASCII comparison operators.",
  "version": "1.0.1",
  "publisher": "orhun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orhunlang/orhun.git",
    "directory": "tools/vscode-orhun"
  },
  "homepage": "https://github.com/orhunlang/orhun",
  "bugs": {
    "url": "https://github.com/orhunlang/orhun/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "orhun",
    "turkish",
    "language",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orhun",
        "aliases": [
          "Orhun",
          "orhun"
        ],
        "extensions": [
          ".oh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orhun",
        "scopeName": "source.orhun",
        "path": "./syntaxes/orhun.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "orhun",
        "path": "./snippets/orhun.code-snippets"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  }
}
